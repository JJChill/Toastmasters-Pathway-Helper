{
  "extraKnownMarketplaces": {
    "jjchill-agent-skills": {
      "source": {
        "source": "github",
        "repo": "JJChill/agent-skills"
      }
    }
  },
  "enabledPlugins": {
    "agent-skills@jjchill-agent-skills": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && ./node_modules/.bin/probity-claude"
          }
        ]
      }
    ]
  }
}
